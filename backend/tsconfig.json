{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist"]
}